[OnlineCourses.App/IConsole.cs]
dotnet_diagnostic.CS1591.severity = warning
[OnlineCourses.App/RegistrationItemParser.cs]
dotnet_diagnostic.CS1591.severity = warning
[OnlineCourses.App/SystemConsoleAdapter.cs]
dotnet_diagnostic.CS1591.severity = warning
[OnlineCourses.Core/Documents/ClientInfo.cs]
dotnet_diagnostic.CS1591.severity = warning
[OnlineCourses.Core/Documents/DocumentGuards.cs]
dotnet_diagnostic.CS1591.severity = warning
[OnlineCourses.Core/Documents/DocumentTotalCalculator.cs]
dotnet_diagnostic.CS1591.severity = warning

# Повна перевірка XML-документації всього публічного API виробничих збірок.
[src/OnlineCourses.Core/**/*.cs]
dotnet_diagnostic.CS1591.severity = warning
[src/OnlineCourses.App/**/*.cs]
dotnet_diagnostic.CS1591.severity = warning

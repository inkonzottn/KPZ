dotnet_diagnostic.CS1591.severity = warning
[OnlineCourses.Core/Documents/DocumentStatus.cs]
dotnet_diagnostic.CS1591.severity = warning
[OnlineCourses.Core/Domain/Registration.cs]
dotnet_diagnostic.CS1591.severity = warning
[OnlineCourses.Core/Domain/RegistrationItem.cs]
dotnet_diagnostic.CS1591.severity = warning
[OnlineCourses.Core/Services/RegistrationService.cs]

dotnet_diagnostic.CS1591.severity = warning
[OnlineCourses.Core/Services/EnrollmentSearchCriteria.cs]
dotnet_diagnostic.CS1591.severity = warning
[OnlineCourses.Core/Pricing/CoursePackagePrice.cs]
dotnet_diagnostic.CS1591.severity = warning
[OnlineCourses.Core/Pricing/CoursePackagePricingPolicy.cs]
dotnet_diagnostic.CS1591.severity = warning
